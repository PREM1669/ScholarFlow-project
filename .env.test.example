# Use a dedicated, disposable Supabase project/database for E2E tests.
# Never copy your development DATABASE_URL or DIRECT_URL here.
DATABASE_URL="postgresql://postgres:YOUR_TEST_PASSWORD@YOUR_TEST_PROJECT.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_TEST_PASSWORD@YOUR_TEST_PROJECT.supabase.co:5432/postgres"
NEXTAUTH_URL="http://127.0.0.1:3101"
NEXTAUTH_SECRET="replace-with-a-random-test-only-secret"
